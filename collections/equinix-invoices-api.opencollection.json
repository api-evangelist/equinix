{
  "opencollection": "1.0.0",
  "info": {
    "name": "Equinix API Authentication Invoices API",
    "version": "1.2"
  },
  "items": [
    {
      "info": {
        "name": "Invoices",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve an invoice",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.equinix.com/invoices/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Invoice UUID"
              }
            ]
          },
          "docs": "Returns the invoice identified by the provided id"
        },
        {
          "info": {
            "name": "Retrieve all invoices for an organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.equinix.com/organizations/:id/invoices",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Organization UUID"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "page number"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "per page"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "filter by status"
              }
            ]
          },
          "docs": "Returns all invoices for an organization"
        }
      ]
    }
  ],
  "bundled": true
}