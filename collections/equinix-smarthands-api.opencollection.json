            "name": "Get locations(ibx, cage) details for placing smart hands based on smart hands permission for user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.equinix.com/v1/orders/smarthands/locations",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "detail",
                "value": "",
                "type": "query",
                "description": "When enable this flag returns detailed permission with Cage & Cabinets."
              },
              {
                "name": "ibxs",
                "value": "",
                "type": "query",
                "description": "Example: AM1,AM2"
              },
              {
                "name": "cages",
                "value": "",
                "type": "query",
                "description": "Example: AM1:02:002MC1"
              }
            ]
          },
          "docs": "Get locations(ibx, cage) details for placing smart hands based on smart hands permission for user"
