        {
          "info": {
            "name": "List Current VLAN assignments for a port",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.equinix.com/ports/:id/vlan-assignments",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Port UUID"
              },
              {
                "name": "include",
