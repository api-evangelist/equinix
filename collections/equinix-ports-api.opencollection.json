  "items": [
    {
      "info": {
        "name": "Ports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a port",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.equinix.com/ports/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Port UUID"
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Nested attributes to include. Included objects will return their full\nattributes. Attribute names can be dotted (up to 3 levels) to included deeply\nnested objects."
              }
            ]
          },
          "docs": "Returns a port"
        },
        {
          "info": {
            "name": "Assign a port to virtual network",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.equinix.com/ports/:id/assign",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Port UUID"
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Nested attributes to include. Included objects will return their full\nattributes. Attribute names can be dotted (up to 3 levels) to included deeply\nnested objects."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Assign a hardware port to a virtual network."
        },
        {
