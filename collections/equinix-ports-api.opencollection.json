          "http": {
            "method": "POST",
            "url": "https://api.equinix.com/ports/:id/convert/layer-2",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Port UUID"
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Nested attributes to include. Included objects will return their full\nattributes. Attribute names can be dotted (up to 3 levels) to included deeply\nnested objects."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Converts a bond port to Layer 2. IP assignments of the port will be removed."
        },
